<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arquivo de supressão compartilhado do OWASP Dependency Check para todos os
  projetos HubSaúde. Empacotado pelo hubsaude-build-tools e desempacotado pelo
  perfil "security" definido no hubsaude-parent.

  Política:
  - Falsos positivos comprovados (CPE/Package mismatch).
  - CVEs aceitos temporariamente quando NÃO há release upstream com correção
    e/ou existe mitigação efetiva por boundary/configuração.
  - Toda supressão temporária deve ter atributo "until" e ser reavaliada na
    rodada do orquestrador de qualidade.

  Documentação: https://jeremylong.github.io/DependencyCheck/general/suppression.html
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ================================================================
         Falsos positivos
         ================================================================ -->

    <!-- groupId br.gov.go.saude.hubsaude casa com CPE "go:go" do Go lang. -->
    <suppress>
        <notes><![CDATA[
        False positive: CPE "go:go" é incorretamente associado ao groupId
        "br.gov.go.saude.hubsaude" (módulos internos Java, sem relação com Go).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/br\.gov\.go\.saude\.hubsaude/.*@.*$</packageUrl>
        <cpe>cpe:/a:go:go</cpe>
    </suppress>

    <!-- org.hl7.fhir.* 6.7.9 são módulos do HL7 FHIR core (versão própria),
         não da framework HAPI FHIR (8.8.1). O CPE mapeia incorretamente
         a versão 6.7.9 para hapi_fhir:6.7.9 em alguns CVEs antigos. -->
    <suppress>
        <notes><![CDATA[
        False positive de CPE: org.hl7.fhir.* version 6.7.9 é a HL7 core
        structures library bundled com HAPI FHIR 8.8.1. Os números de versão
        diferem entre HL7 core library e HAPI FHIR framework.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/ca\.uhn\.hapi\.fhir/org\.hl7\.fhir\..*@6\.7\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-33180</vulnerabilityName>
    </suppress>

    <!-- ================================================================
         Aceites temporários por incompatibilidade upstream
         ================================================================ -->

    <!-- thymeleaf 3.1.3: Spring Boot 4.0.3 chama método removido em 3.1.5
         (NoSuchMethodError em StandardExpressionExecutionContext). Aguardar
         Spring Boot 4.0.4+ ou thymeleaf 3.2.x. Mitigação: templates server-side
         do HubSaúde não recebem expressão dinâmica de fonte não confiável. -->
    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        Pinado por Spring Boot 4.0.3 (incompat com thymeleaf 3.1.5).
        Templates HubSaúde só recebem dados estruturados internos.
        Reavaliar quando Spring Boot 4.0.4 ou superior estiver disponível.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.thymeleaf/thymeleaf@3\.1\.[0-4]\.RELEASE$</packageUrl>
        <vulnerabilityName>CVE-2026-40477</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Mesma justificativa do CVE-2026-40477.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.thymeleaf/thymeleaf@3\.1\.[0-4]\.RELEASE$</packageUrl>
        <vulnerabilityName>CVE-2026-40478</vulnerabilityName>
    </suppress>

    <!-- org.hl7.fhir.utilities/validation 6.7.9: hapi-fhir 8.8.1 NÃO suporta
         fhir-core 6.9.x (StackOverflow em ValidatorWrapper.buildInstanceValidator).
         Mitigação: validação roda atrás do gateway com mTLS/JWT; payloads não
         confiáveis passam pelo boundary do DefaultFhirValidationFacade. -->
    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        Pinado por hapi-fhir 8.8.1 (incompat com fhir-core 6.9.x).
        Mitigação por gateway autenticado + boundary validation.
        Reavaliar a cada upgrade do hapi-fhir.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/ca\.uhn\.hapi\.fhir/org\.hl7\.fhir\.utilities@6\.7\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-34359</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Mesma justificativa do CVE-2026-34359.]]></notes>
        <packageUrl regex="true">^pkg:maven/ca\.uhn\.hapi\.fhir/org\.hl7\.fhir\.validation@6\.7\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-34361</vulnerabilityName>
    </suppress>

    <!-- libthrift 0.22.0: última release pública (sem patch para CVEs 2026).
         Transitivo via fhir-core (serialização interna). Sem servidor Thrift
         exposto pelo HubSaúde. Reavaliar quando Apache Thrift 0.23+ sair. -->
    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        libthrift 0.22.0 é a última release; sem patch upstream. Uso é
        transitivo (serialização interna do fhir-core), sem servidor Thrift
        exposto pelo HubSaúde.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\..*$</packageUrl>
        <cve>CVE-2026-41605</cve>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[libthrift 0.22.0 sem patch upstream.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\..*$</packageUrl>
        <cve>CVE-2026-41604</cve>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[libthrift 0.22.0 sem patch upstream.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\..*$</packageUrl>
        <cve>CVE-2026-41603</cve>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[libthrift 0.22.0 sem patch upstream.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\..*$</packageUrl>
        <cve>CVE-2026-41636</cve>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[libthrift 0.22.0 sem patch upstream.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\..*$</packageUrl>
        <cve>CVE-2026-41602</cve>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[libthrift 0.22.0 sem patch upstream.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.thrift/libthrift@0\.22\..*$</packageUrl>
        <cve>CVE-2025-48431</cve>
    </suppress>

