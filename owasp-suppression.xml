<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arquivo de supressão do OWASP Dependency Check específico do
  hubsaude-cliente-java. Este projeto usa este arquivo local via perfil
  "security" (ver pom.xml).

  Política:
  - Somente supressões aplicáveis às dependências declaradas no pom.xml
    deste projeto (BouncyCastle, Jackson 3, SLF4J, jjwt e logback).
  - Falsos positivos comprovados (CPE/Package mismatch).
  - CVEs aceitos temporariamente quando NÃO há release upstream com
    correção e/ou existe mitigação efetiva verificável NESTE projeto.
  - Preferir supressão por versão exata; evitar regex de série que
    silencie versões futuras sem revisão.
  - Toda supressão temporária deve ter atributo "until" e ser reavaliada
    até essa data na rodada do orquestrador de qualidade.

  Documentação: https://jeremylong.github.io/DependencyCheck/general/suppression.html
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ================================================================
         Falsos positivos
         ================================================================ -->

    <!-- groupId br.gov.go.saude.hubsaude casa com CPE "go:go" do Go lang. -->
    <suppress>
        <notes><![CDATA[
        False positive: CPE "go:go" é incorretamente associado ao groupId
        "br.gov.go.saude.hubsaude" (módulos internos Java, sem relação com Go).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/br\.gov\.go\.saude\.hubsaude/.*@.*$</packageUrl>
        <cpe>cpe:/a:go:go</cpe>
    </suppress>

</suppressions>
