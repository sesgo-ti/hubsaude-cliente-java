    <!-- Jackson 3.0.4: pinado pelo Spring Boot 4.0.3 (incompat com 3.1.x —
         NoClassDefFoundError em runtime). CVE-2026-29062 afeta jackson-core.
         Mitigação: ObjectMapper do HubSaúde rejeita propriedades desconhecidas
         e roda atrás do gateway autenticado. -->
    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        Jackson 3.0.4 pinado por Spring Boot 4.0.3 (3.1.x quebra compatibilidade
        binária). Mitigação: ObjectMapper restritivo + gateway autenticado.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/tools\.jackson\.core/jackson-(core|databind|annotations)@3\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-29062</vulnerabilityName>
    </suppress>

    <!-- Spring Framework 7.0.5: aguardando Spring Boot 4.0.4 (que pinará 7.0.7).
         Atualizar isoladamente quebra Spring Boot 4.0.3. -->
    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        spring-web 7.0.5 pinado por Spring Boot 4.0.3 (override isolado é
        arriscado). Mitigação por gateway mTLS+JWT.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-(web|core|context|beans|aop|expression|webmvc|webflux)@7\.0\.[0-6]$</packageUrl>
        <vulnerabilityName>CVE-2026-22740</vulnerabilityName>
    </suppress>

    <!-- opentelemetry-semconv: o CPE "opentelemetry:opentelemetry" é casado
         com QUALQUER artefato io.opentelemetry.* da mesma versão. CVE-2026-39883
         e CVE-2026-29181 afetam o agent (não o módulo de constantes semconv).
         False positive efetivo: semconv só contém constantes string. -->
    <suppress>
        <notes><![CDATA[
        False positive: opentelemetry-semconv contém apenas constantes string
        de attribute keys. Os CVEs 2026-39883 e 2026-29181 afetam o agent
        (instrumentation), não o semconv.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry\.semconv/opentelemetry-semconv@.*$</packageUrl>
        <vulnerabilityName>CVE-2026-39883</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[Mesma justificativa do CVE-2026-39883.]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry\.semconv/opentelemetry-semconv@.*$</packageUrl>
        <vulnerabilityName>CVE-2026-29181</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
        False positive: CVE-2026-39882 afeta exclusivamente a implementação
        OpenTelemetry-Go (exporter OTLP HTTP sem cap no buffer de resposta),
        conforme CPE oficial cpe:2.3:a:opentelemetry:opentelemetry:*:*:*:*:*:go:*:*.
        O CPE genérico opentelemetry:opentelemetry é casado pelo dependency-check
        contra o artefato Java io.opentelemetry.semconv:opentelemetry-semconv,
        que contém apenas constantes string de attribute keys (sem código de
        rede/HTTP). Sem caminho de exploração na JVM.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry\.semconv/opentelemetry-semconv@.*$</packageUrl>
        <vulnerabilityName>CVE-2026-39882</vulnerabilityName>
    </suppress>

    <!-- log4j-api 2.25.3: CVE-2026-34478/34479/34480/34481 têm CVSS < 7.0, mas o
          plugin OWASP escala por bug de parsing CVSSv4 (ProviderUrgencyType
          exception em CvssUtil.vectorToCvssV4). Suprimir até atualização do
          dependency-check-maven. CVEs afetam Pattern Layout/JNDI parsing —
          configuração HubSaúde não usa esses recursos. -->
    <suppress>
        <notes><![CDATA[
        log4j-api 2.25.3 com CVSS<7. Suprimido por bug de parsing CVSSv4 do
        OWASP dependency-check (escala falsamente). Configuração HubSaúde
        usa Logback (logback-classic), não Pattern Layout do Log4j.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-(api|core|to-slf4j)@2\.25\..*$</packageUrl>
        <cve>CVE-2026-34478</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Mesma justificativa do CVE-2026-34478.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-(api|core|to-slf4j)@2\.25\..*$</packageUrl>
        <cve>CVE-2026-34480</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Mesma justificativa do CVE-2026-34478.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-(api|core|to-slf4j)@2\.25\..*$</packageUrl>
        <cve>CVE-2026-34479</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[Mesma justificativa do CVE-2026-34478.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-(api|core|to-slf4j)@2\.25\..*$</packageUrl>
        <cve>CVE-2026-34481</cve>
    </suppress>

