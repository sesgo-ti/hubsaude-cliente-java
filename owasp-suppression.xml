        <notes><![CDATA[Mesma justificativa do thymeleaf-3.1.3 (incompat Spring Boot 4.0.3 com 3.1.5).]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.thymeleaf/thymeleaf-spring6@3\.1\.[0-4]\.RELEASE$</packageUrl>
        <vulnerabilityName>CVE-2026-40477</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Mesma justificativa do thymeleaf-3.1.3.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.thymeleaf/thymeleaf-spring6@3\.1\.[0-4]\.RELEASE$</packageUrl>
        <vulnerabilityName>CVE-2026-40478</vulnerabilityName>
    </suppress>

    <!-- Netty 4.2.10: pinado pelo reactor-netty-http 1.3.3 (Spring Boot 4.0.3).
         Override do BOM via netty-bom NÃO é respeitado porque o spring-boot-
         dependencies importa Netty antes. CVE-2026-33871 (CVSS 7.5) afeta
         processamento HTTP/2; mitigação: gateway TLS + filtro de tamanho
         de header já configurado. Aguardando reactor-netty 1.3.4+. -->
    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        Netty 4.2.10 pinado por reactor-netty 1.3.3 (Spring Boot 4.0.3).
        Mitigação: TLS + limites de header no gateway. Aguardar reactor-netty 1.3.4.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/netty-(codec-http2|codec-http|codec-base|codec-compression|handler|buffer|transport|common)@4\.2\.(10|11)\.Final$</packageUrl>
        <vulnerabilityName>CVE-2026-33871</vulnerabilityName>
    </suppress>

</suppressions>
