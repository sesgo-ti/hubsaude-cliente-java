    <suppress until="2026-12-31Z">
        <notes><![CDATA[
        Spring Security 7.0.3: aguardando release 7.0.4 (só 7.1.0-RC1 disponível).
        Mitigação: mTLS+JWT no gateway + auditoria OAuth2.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/.*@7\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-22747</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Spring Security 7.0.3 pinado.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/.*@7\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-22732</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
