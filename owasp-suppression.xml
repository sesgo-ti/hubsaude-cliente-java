        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@4\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-40975</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Spring Boot 4.0.3 pinado; mitigação por gateway.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@4\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-22733</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Spring Boot 4.0.3 pinado; mitigação por gateway.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@4\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-40976</vulnerabilityName>
