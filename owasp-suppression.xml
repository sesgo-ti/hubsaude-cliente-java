        <vulnerabilityName>CVE-2026-40973</vulnerabilityName>
    </suppress>
    <suppress until="2026-12-31Z">
        <notes><![CDATA[Spring Boot 4.0.3 pinado; mitigação por gateway.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@4\.0\..*$</packageUrl>
        <vulnerabilityName>CVE-2026-22731</vulnerabilityName>
    </suppress>

    <!-- Spring Security 7.0.3: aguardando 7.0.4 (só 7.1.0-RC1 disponível).
