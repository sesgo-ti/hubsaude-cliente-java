            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Daniel Nogueira da Costa</name>
            <url>https://github.com/nogueiralegacy</url>
            <organization>UFG/INF — Fábrica de Software</organization>
            <organizationUrl>https://fs.inf.ufg.br/</organizationUrl>
            <timezone>America/Sao_Paulo</timezone>
        </developer>
        <developer>
            <name>Fábio Nogueira de Lucena</name>
            <url>https://github.com/kyriosdata</url>
            <organization>UFG/INF — Fábrica de Software</organization>
            <organizationUrl>https://fs.inf.ufg.br/</organizationUrl>
            <timezone>America/Sao_Paulo</timezone>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/FabricaDeSoftwareINF/server-hubsaude.git</connection>
        <developerConnection>scm:git:git@github.com:FabricaDeSoftwareINF/server-hubsaude.git</developerConnection>
        <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude/tree/main/hubsaude/projetos/hubsaude-cliente-java</url>
        <tag>HEAD</tag>
    </scm>

