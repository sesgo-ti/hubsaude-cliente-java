<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.go.saude.hubsaude</groupId>
        <artifactId>hubsaude-parent</artifactId>
        <version>0.1.3-SNAPSHOT</version>
        <relativePath />
    </parent>

    <!--
        SPDX-License-Identifier: Apache-2.0

        Publicação no GitHub Packages do monorepo HubSaúde
        (`maven.pkg.github.com/FabricaDeSoftwareINF/server-hubsaude`),
        conforme demais módulos. O `groupId` e o
        `distributionManagement` são herdados de `hubsaude-parent`.

        Migração futura para Maven Central está planejada em
        `plano.md` (depende de verificação do namespace
        `br.gov.go.saude` e setup GPG).
    -->
    <artifactId>hubsaude-cliente-java</artifactId>
    <version>0.1.5</version>

    <name>HubSaúde Cliente Java</name>
    <description>Cliente Java para facilitar a obtenção de tokens de acesso ao HubSaúde via SMART Backend Services (SMART-on-FHIR), o fluxo de autenticação máquina-a-máquina (M2M) exigido pela plataforma. Encapsula a montagem do JWT de client assertion, a assinatura com a chave privada do credenciado e a requisição ao endpoint de token, expondo uma API simples para que aplicações consumidoras obtenham e renovem tokens sem reimplementar o protocolo.</description>
    <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude</url>
    <inceptionYear>2025</inceptionYear>

    <organization>
        <name>Estado de Goiás — Secretaria de Estado da Saúde (SES-GO)</name>
        <url>https://www.saude.go.gov.br/</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Daniel Nogueira da Costa</name>
            <url>https://github.com/nogueiralegacy</url>
            <organization>UFG/INF — Fábrica de Software</organization>
            <organizationUrl>https://fs.inf.ufg.br/</organizationUrl>
            <timezone>America/Sao_Paulo</timezone>
        </developer>
        <developer>
            <name>Fábio Nogueira de Lucena</name>
            <url>https://github.com/kyriosdata</url>
            <organization>UFG/INF — Fábrica de Software</organization>
            <organizationUrl>https://fs.inf.ufg.br/</organizationUrl>
            <timezone>America/Sao_Paulo</timezone>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/FabricaDeSoftwareINF/server-hubsaude.git</connection>
        <developerConnection>scm:git:git@github.com:FabricaDeSoftwareINF/server-hubsaude.git</developerConnection>
        <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude/tree/main/hubsaude/projetos/hubsaude-cliente-java</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude/actions</url>
    </ciManagement>

    <properties>
        <!--
            hubsaude-cliente-java é publicado no GitHub Packages do
            monorepo. Sobrescreve o maven.deploy.skip=true herdado de
            hubsaude-foundation (interno-only por padrão).
        -->
        <maven.deploy.skip>false</maven.deploy.skip>

        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.10.1</maven-javadoc-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- JWT: criação e validação de tokens (JJWT) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            BouncyCastle: parse de certificados X.509 e chaves PEM.
            bcpkix fornece cert/openssl/pkcs/operator usados por
            PemLoader e SslContextFactory; bcprov é declarado
            explicitamente porque PemLoader importa
            org.bouncycastle.asn1.pkcs.PrivateKeyInfo (artefato bcprov),
            evitando depender da resolução transitiva via bcpkix.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <!-- Jackson: parse de respostas JSON do token endpoint -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- SLF4J: API de logging (implementação fornecida pelo runtime) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- SpotBugs annotations -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Logback para testes -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Simulador SMART on FHIR para testes de integração (obtido via Maven, não path local) -->
        <dependency>
            <groupId>br.gov.go.saude.hubsaude</groupId>
            <artifactId>hubsaude-simulador</artifactId>
            <version>0.1.3-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>br.gov.go.saude.hubsaude</groupId>
            <artifactId>hubsaude-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Fitness functions arquiteturais (ADR-15) — regras
             ArchUnit compartilhadas pelo módulo hubsaude-arch-rules. -->
        <dependency>
            <groupId>br.gov.go.saude.hubsaude</groupId>
            <artifactId>hubsaude-arch-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>

            <!-- JaCoCo: cobertura mínima de 85% -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.85</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                    <!-- Exclui métodos específicos que requerem hardware PKCS#11/HSM -->
                    <excludes>
                        <exclude>**/SigningStrategyFactory$*Pkcs11*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Copia o JAR do simulador para target/simulator (necessário para Testcontainers) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <!--
                        Dependências consumidas em runtime (não por
                        imports Java), invisíveis ao goal analyze:
                        - hubsaude-simulador: JAR copiado para
                          target/simulator e iniciado via Testcontainers
                          nos testes de integração (*IT.java).
                        - jjwt-impl / jjwt-jackson: runtime do JJWT
                          carregado via ServiceLoader.
                        - logback-classic: binding SLF4J em testes.
                        - spring-boot-configuration-processor:
                          annotation processor (compile-time).
                        - junit-jupiter / archunit-junit5: agregadores
                          cujos artefatos efetivos (api/params/engine)
                          são detectados em vez deles.
                    -->
                    <usedDependencies>
                        <dependency>br.gov.go.saude.hubsaude:hubsaude-simulador</dependency>
                        <dependency>io.jsonwebtoken:jjwt-impl</dependency>
                        <dependency>io.jsonwebtoken:jjwt-jackson</dependency>
                        <dependency>ch.qos.logback:logback-classic</dependency>
                        <dependency>org.springframework.boot:spring-boot-configuration-processor</dependency>
                        <dependency>org.junit.jupiter:junit-jupiter</dependency>
                        <dependency>com.tngtech.archunit:archunit-junit5</dependency>
                    </usedDependencies>
                </configuration>
                <executions>
                    <execution>
                        <id>copy-simulator</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>br.gov.go.saude.hubsaude</groupId>
                                    <artifactId>hubsaude-simulador</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <destFileName>hubsaude-simulador.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/simulator</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Configuração para testes unitários (exclui testes de integração) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            
            <!-- Configuração para testes de integração (requer simulador em execução) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <groups>integration</groups>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
            Perfil "release": ativado por `mvn -P release deploy`.

            Responsabilidades:
            - maven-source-plugin: empacota código-fonte (sources.jar);
            - maven-javadoc-plugin: gera Javadoc (javadoc.jar);
            - cyclonedx-maven-plugin: anexa SBOM (classificador
              "cyclonedx") para SLSA/transparência da supply chain.

            Publicação no GitHub Packages usa o `distributionManagement`
            herdado de `hubsaude-parent` (server-id `github-hubsaude`).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <locale>pt_BR</locale>
                            <doclint>none</doclint>
                            <source>21</source>
                            <quiet>true</quiet>
                            <failOnError>true</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>${cyclonedx-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-sbom</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                                <configuration>
                                    <outputName>${project.artifactId}-${project.version}-cyclonedx</outputName>
                                    <outputFormat>json</outputFormat>
                                    <schemaVersion>1.5</schemaVersion>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
