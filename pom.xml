                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                                <configuration>
                                    <outputName>${project.artifactId}-${project.version}-cyclonedx</outputName>
                                    <outputFormat>json</outputFormat>
                                    <schemaVersion>1.5</schemaVersion>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
