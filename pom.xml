        </dependency>
        <!-- Logback para testes -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Simulador SMART on FHIR para testes de integração (obtido via Maven, não path local) -->
        <dependency>
            <groupId>br.gov.go.saude.hubsaude</groupId>
            <artifactId>hubsaude-simulador</artifactId>
            <version>${hubsaude-simulador.version}</version>
