<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Projeto standalone (sem <parent>, sem import de BOM externo).
        hubsaude-cliente-java é uma biblioteca consumida por aplicações
        externas — inclusive fora do monorepo HubSaúde. Herdar de
        hubsaude-parent (publicado apenas no GitHub Packages privado)
        impediria a resolução do POM em qualquer repositório público
        (Maven Central, mirror corporativo etc.) e arrastaria toda a
        superfície do BOM HubSaúde para os consumidores. Mesma
        motivação do ADR-35 (bom/build-tools).

        Versionamento de dependências externas é feito INTEIRAMENTE
        aqui (properties + <dependencyManagement> próprio), sem
        import do hubsaude-bom. Razão: hubsaude-bom é SNAPSHOT (ADR-36
        proíbe SNAPSHOT publicado), forneceria versionamento acoplado
        ao ciclo do monorepo e exigiria install local no CI — trade-offs
        inaceitáveis para uma lib publicada externamente. O
        flatten-maven-plugin (modo `oss`) reescreve o POM publicado
        apenas removendo <parent>; não há import a in-linar.
    -->
    <groupId>br.gov.go.saude.hubsaude</groupId>
    <artifactId>hubsaude-cliente-java</artifactId>
    <version>0.1.8-SNAPSHOT</version>

    <name>HubSaúde Cliente Java</name>
    <description>Cliente Java para facilitar a obtenção de tokens de acesso ao HubSaúde via SMART Backend Services (SMART-on-FHIR), o fluxo de autenticação máquina-a-máquina (M2M) exigido pela plataforma. Encapsula a montagem do JWT de client assertion, a assinatura com a chave privada do credenciado e a requisição ao endpoint de token, expondo uma API simples para que aplicações consumidoras obtenham e renovem tokens sem reimplementar o protocolo.</description>
    <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude</url>
    <inceptionYear>2025</inceptionYear>

    <organization>
        <name>Estado de Goiás — Secretaria de Estado da Saúde (SES-GO)</name>
        <url>https://www.saude.go.gov.br/</url>
    </organization>

