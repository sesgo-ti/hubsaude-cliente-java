<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Configuração Checkstyle para CÓDIGO DE TESTE do hubsaude-cliente-java.

    Escopo intencionalmente mínimo: aplica apenas a convenção de
    asserção única (REC-27, issue #584) — AssertJ é a biblioteca de
    asserção para todo código de teste. Réplica local (este projeto é
    auto-suficiente, não consome hubsaude-build-tools) do
    checkstyle-tests.xml central.

    Exceção documentada (docs/QUALITY-GATE.md do monorepo): matchers
    Hamcrest usados de forma idiomática com MockMvc jsonPath permanecem
    permitidos via nome totalmente qualificado inline (sem import).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- REC-27: proíbe JUnit Assertions (import normal e static)
             e imports de org.hamcrest em código de teste. -->
        <module name="IllegalImport">
            <property name="regexp" value="true"/>
            <property name="illegalPkgs" value="org\.hamcrest"/>
            <property name="illegalClasses"
                      value="^org\.junit\.jupiter\.api\.Assertions(\..+)?$"/>
            <message key="import.illegal"
                     value="Import proibido: {0} — use AssertJ (org.assertj.core.api.Assertions); convenção REC-27 em docs/QUALITY-GATE.md."/>
        </module>
    </module>
</module>
