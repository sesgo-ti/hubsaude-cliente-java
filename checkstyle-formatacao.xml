<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Verificação de formatação de arquivo — configuração LOCAL deste projeto.

    As demais regras Checkstyle vêm da configuração central do
    Os módulos abaixo complementam o gate principal com verificações de
    whitespace e final de arquivo;
    este projeto NÃO usa Spotless, então a verificação é mantida aqui.

    Não é cópia de arquivo central: não está sujeita a drift.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>

    <!-- Trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Linha contém espaços em branco no final"/>
    </module>
</module>
